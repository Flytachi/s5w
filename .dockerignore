.DS_Store
*.buildpath
*.project
.settings

# Dependencies (composer)
vendor

# Environment & secrets
.env
.runtime_secrets

# What the framework writes at runtime (process state, build caches), and file logs
.winter
logs

# The panel's own build artefacts: built again in the image
frontend/node_modules
frontend/.nuxt
frontend/.output
frontend/.data

# Project documentation: not read at runtime (the API docs are published on the docs site).
# LICENSE and NOTICE stay in the image on purpose — Apache-2.0 asks for them to ship with it.
docs
README.md
CHANGELOG.md
SECURITY.md

# Tests
phpunit.xml
.phpunit.result.cache

# Docker files
docker-compose.yml
Dockerfile